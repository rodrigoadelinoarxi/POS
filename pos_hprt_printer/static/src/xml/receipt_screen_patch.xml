<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_hprt_printer.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('print')]" position="after">
            <button class="button print btn btn-lg btn-primary w-100 py-3 mt-1" t-on-click="printOnHprt">
                <i class="fa fa-print ms-2"/> Imprimir Talão
            </button>
            <button class="button print btn btn-lg btn-warning w-100 py-3 mt-1" t-on-click="sendToKitchen">
                <i class="fa fa-cutlery ms-2"/> Imprimir Bebidas
            </button>
        </xpath>
    </t>
</templates>
